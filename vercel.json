{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npx vite build --config vercel.vite.config.ts",
      "outputDirectory": "dist-vercel"
    },
    "devhost": {
      "root": "packages/tools/devHost",
      "framework": "vite",
      "installCommand": "cd ../../.. && npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
